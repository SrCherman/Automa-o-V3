# ==============================================================================
# Automação V3 - Modelo de Configuração de Ambiente (.env.example)
# Copie este arquivo para .env e preencha com suas credenciais oficiais.
# NUNCA commite o arquivo .env no controle de versão!
# ==============================================================================

# --- Credenciais Mind7 ---
MIND7_LOGIN_URL=https://mind-7.org/acesso/
MIND7_URL=https://mind-7.org/painel/consultas/celular/
MIND7_CPF_URL=https://mind-7.org/painel/consultas/cpf/
MIND7_USER=seu_email@exemplo.com
MIND7_PASS=sua_senha_aqui
MIND7_DEBUG_PORT=9223

# --- Credenciais Itaú Credline ---
CREDLINE_URL=https://www.credlineitau.com.br/new-simulator
CREDLINE_USER=seu_usuario@exemplo.com
CREDLINE_PASS=sua_senha_aqui
ITAU_DEBUG_PORT=9224

# --- C6 Auto: credenciais somente no .env local ---
C6_USER=
C6_PASS=

# --- Configurações de Execução ---
HEADLESS=false
MAX_WORKERS=2
CAPTCHA_API_KEY=

# --- Banco de Dados ---
# Por padrão utiliza SQLite local em data/database.sqlite
# DATABASE_URL=sqlite:///data/database.sqlite
